{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SkillPath: API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python",
      "args": ["-m", "uvicorn", "api.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "skillpath" }
    },
    {
      "label": "SkillPath: App (web)",
      "type": "shell",
      "command": "npx",
      "args": ["expo", "start", "--web"],
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "skillpath" }
    },
    {
      "label": "SkillPath: Start all",
      "dependsOn": ["SkillPath: API", "SkillPath: App (web)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "SkillPath: Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
