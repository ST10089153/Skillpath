{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SkillPath: API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python",
      "args": ["-m", "uvicorn", "api.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "skillpath" }
    },
    {
      "label": "SkillPath: App (web)",
      "type": "shell",
      "command": "npx",
      "args": ["expo", "start", "--web"],
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "skillpath" }
    },
    {
      "label": "SkillPath: Start all",
      "dependsOn": ["SkillPath: API", "SkillPath: App (web)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "SkillPath: App (web, live link)",
      "detail": "Use with VS Code port forwarding: paste the forwarded address of port 8000",
      "type": "shell",
      "command": "npx",
      "args": ["expo", "start", "--web"],
      "options": {
        "cwd": "${workspaceFolder}/app",
        "env": { "EXPO_PUBLIC_API_URL": "${input:forwardedApiUrl}" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "skillpath" }
    },
    {
      "label": "SkillPath: Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "forwardedApiUrl",
      "type": "promptString",
      "description": "Forwarded address of port 8000 from the VS Code Ports panel (e.g. https://abc123-8000.euw.devtunnels.ms)"
    }
  ]
}
